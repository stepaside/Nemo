<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <RestorePackages>true</RestorePackages>
    <RequireLicenseAcceptance>false</RequireLicenseAcceptance>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Language>en-US</Language>
    <NeutralLanguage>en-US</NeutralLanguage>
    <AssemblyName>Nemo</AssemblyName>
    <AssemblyTitle>Nemo</AssemblyTitle>
    <PackageVersion>3.0.0</PackageVersion>
    <RootNamespace>Nemo</RootNamespace>

    <PackageId>Nemo</PackageId>
    <Title>Nemo</Title>
    <Description>Enterprise-ready .NET micro-ORM combining blazing performance with rich features. Stop choosing between speed and productivity - get compiled expression performance, built-in caching, validation, serialization, Unit of Work, and native multi-database support in one lightweight package.</Description>
    <Authors>Max Stepanskiy</Authors>
    <Company>Stepaside, Inc.</Company>
    <Copyright>Copyright © Max Stepanskiy 2012-2025</Copyright>
    <PackageProjectUrl>https://github.com/stepaside/Nemo/wiki</PackageProjectUrl>
    <PackageTags>ORM micro-ORM enterprise performance caching validation serialization unit-of-work multi-database dotnet csharp sql postgresql mysql sqlserver</PackageTags>
    
    <RepositoryUrl>https://github.com/stepaside/Nemo</RepositoryUrl>
    <RepositoryType>Github</RepositoryType>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  
  <ItemGroup>
    <InternalsVisibleTo Include="Nemo.UnitTests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'netstandard2.1' or '$(TargetFramework)' == 'net10.0'">
	<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
	<PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Reflection.Emit" Version="4.7.0" />
    <PackageReference Include="System.Reflection.Emit.ILGeneration" Version="4.7.0" />
    <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
	<PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.11" />
	<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
	<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
	<Reference Include="System.ComponentModel.DataAnnotations" />
	<Reference Include="System.Data.DataSetExtensions" />
	<Reference Include="System.Runtime.Caching" />
	<Reference Include="System.Runtime.Serialization" />
	<Reference Include="System.Transactions" />
    <Reference Include="System.Configuration" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
  </ItemGroup>
</Project>
